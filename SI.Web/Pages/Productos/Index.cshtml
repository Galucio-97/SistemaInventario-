@page
@model SI.Web.Pages.Productos.IndexModel
@{
    ViewData["Title"] = "Catálogo de Productos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Catálogo de Productos</h1>
        <p class="text-muted mb-0">Gestión de productos, existencias y estados de activación (RF-01, RF-05).</p>
    </div>
    <a asp-page="./Crear" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> + Registrar Producto
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.MensajeExito))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @Model.MensajeExito
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @Model.MensajeError
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" style="width: 120px;">Código</th>
                        <th scope="col">Nombre</th>
                        <th scope="col">Descripción</th>
                        <th scope="col" style="width: 120px;">Unidad</th>
                        <th scope="col" style="width: 110px;" class="text-center">Estado</th>
                        <th scope="col" style="width: 140px;" class="text-end">Existencia</th>
                        <th scope="col" style="width: 180px;" class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Productos.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                No hay productos registrados actualmente.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var prod in Model.Productos)
                        {
                            <tr>
                                <td class="fw-bold font-monospace">@prod.Codigo</td>
                                <td>@prod.Nombre</td>
                                <td class="text-muted small">@(string.IsNullOrWhiteSpace(prod.Descripcion) ? "—" : prod.Descripcion)</td>
                                <td>@prod.UnidadMedida</td>
                                <td class="text-center">
                                    @if (prod.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end font-monospace">@prod.ExistenciaActual.ToString("N4")</td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-page="./Editar" asp-route-id="@prod.Id" class="btn btn-outline-primary" title="Editar datos descriptivos">
                                            Editar
                                        </a>
                                        <form method="post" asp-page-handler="CambiarEstado" asp-route-id="@prod.Id" asp-route-nuevoEstado="@(!prod.Activo)" class="d-inline">
                                            <button type="submit" class="btn @(prod.Activo ? "btn-outline-warning" : "btn-outline-success")"
                                                    title="@(prod.Activo ? "Desactivar para bloquear movimientos (RB-10)" : "Activar producto")">
                                                @(prod.Activo ? "Desactivar" : "Activar")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
