@page
@model SI.Web.Pages.Movimientos.EntradaModel
@{
    ViewData["Title"] = "Registrar Entrada de Inventario";
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-7">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <h1 class="h4 mb-0 text-success">Registrar Entrada de Inventario</h1>
                <small class="text-muted">Ingreso atómico de existencias y capas de costeo (RF-02, SI-024, SI-030).</small>
            </div>
            <div class="card-body p-4">
                <form method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    @if (Model.Resultado != null)
                    {
                        <div class="alert alert-success shadow-sm mb-4" role="alert">
                            <h5 class="alert-heading fw-bold mb-2">¡Entrada registrada con éxito!</h5>
                            <hr class="my-2" />
                            <div class="row g-2 small">
                                <div class="col-sm-6">
                                    <strong>Producto:</strong> @Model.Resultado.CodigoProducto - @Model.Resultado.NombreProducto
                                </div>
                                <div class="col-sm-6">
                                    <strong>Cantidad Ingresada:</strong> @Model.Resultado.Cantidad.ToString("N4")
                                </div>
                                <div class="col-sm-6">
                                    <strong>Existencia Anterior:</strong> @Model.Resultado.ExistenciaAnterior.ToString("N4")
                                </div>
                                <div class="col-sm-6">
                                    <strong class="text-success">Nueva Existencia:</strong> @Model.Resultado.ExistenciaNueva.ToString("N4")
                                </div>
                                <div class="col-sm-6">
                                    <strong>Valor Entrada (PEPS):</strong> $@Model.Resultado.CostoTotalPeps.ToString("N2")
                                </div>
                                <div class="col-sm-6">
                                    <strong>Valor Entrada (Promedio):</strong> $@Model.Resultado.CostoTotalPromedio.ToString("N2")
                                </div>
                            </div>
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="Input.ProductoId" class="form-label fw-semibold">Producto (Solo Activos) <span class="text-danger">*</span></label>
                        <select asp-for="Input.ProductoId" class="form-select" autofocus>
                            <option value="">-- Seleccione un producto activo --</option>
                            @foreach (var prod in Model.ProductosActivos)
                            {
                                <option value="@prod.Id">
                                    [@prod.Codigo] @prod.Nombre (Stock actual: @prod.ExistenciaActual.ToString("N4") @prod.UnidadMedida)
                                </option>
                            }
                        </select>
                        <span class="form-text text-muted">Solo se listan productos activos para operaciones de inventario (Regla RB-10).</span>
                    </div>

                    <div class="row">
                        <div class="col-sm-6 mb-3">
                            <label asp-for="Input.Fecha" class="form-label fw-semibold">Fecha del Movimiento <span class="text-danger">*</span></label>
                            <input asp-for="Input.Fecha" class="form-control" type="date" />
                        </div>
                        <div class="col-sm-6 mb-3">
                            <label asp-for="Input.Cantidad" class="form-label fw-semibold">Cantidad de Entrada <span class="text-danger">*</span></label>
                            <input asp-for="Input.Cantidad" class="form-control" type="number" step="0.0001" placeholder="Ej. 10.0000" />
                            <span class="form-text text-muted">Debe ser mayor a 0 (máx. 4 decimales).</span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.CostoUnitario" class="form-label fw-semibold">Costo Unitario ($) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Input.CostoUnitario" class="form-control" type="number" step="0.0001" placeholder="Ej. 25.5000" />
                        </div>
                        <span class="form-text text-muted">Costo de adquisición sin impuestos. Debe ser mayor a 0.</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <a asp-page="/Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-success px-4">Registrar Entrada</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
